/*********
* Azar.jack - Generador pseudoaleatorio de 16 bits: x <- 5x + 3 (la misma
* formula del bono de la seccion 10). Lo usa Carrera para generar obstaculos
* y se inicializa con la semilla del constructor de Carrera.
* Autor 1:
* Autor 2:
* Autor 3:
*********/
class Azar {
    field int x;

    /** Generador con la semilla dada. */
    constructor Azar new(int semilla) {
        let x = semilla;
        return this;
    }

    /** Libera el generador. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** Avanza el generador y devuelve el nuevo valor (aritmetica de 16 bits). */
    method int siguiente() {
        let x = (5 * x) + 3;
        return x;
    }

    /** Entero entre 0 y n-1. */
    method int entero(int n) {
        var int r;
        let r = siguiente();
        if (r < 0) {
            let r = -(r + 1);
        }
        return r - ((r / n) * n);
    }
}
